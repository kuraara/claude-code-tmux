# Copy the values into Portainer's stack environment variables.
PUID=1000
PGID=1500
TZ=Australia/Perth
# Where Claude keeps its files, sign-in and history: a folder on the host, owned by PUID:PGID
# (sudo mkdir -p /srv/claude && sudo chown 1000:1500 /srv/claude).
# Leave it unset to use a Docker volume called claude-data instead.
# CLAUDE_DATA_DIR=/srv/claude
# CLAUDE_CONTEXT_DIR=/srv/claude-context
# CLAUDE_CODE_VERSION=latest
# AUTH_PAGE_HOST_PORT=8765
